# OpenAI — chat + embeddings (use your preferred chat model)
OPENAI_API_KEY=
# Optional override (hackathon brief referenced GPT-5.5; map to your available model id)
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Notion integration token + database IDs (share each DB with the integration)
NOTION_TOKEN=
NOTION_DOGS_DATABASE_ID=
NOTION_MEDICAL_DATABASE_ID=
NOTION_MEDICATIONS_DATABASE_ID=
NOTION_CONSULTATIONS_DATABASE_ID=

# Qdrant — docker-compose.pawmind.yml defaults
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pawmind_medical
# QDRANT_API_KEY=

# CORS for pawmind-web
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

DEFAULT_DOG_NAME=your dog
